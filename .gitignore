node_modules/
dist/
.vite/
__pycache__/
.pytest_cache/
.runtime/
.claude/settings.local.json
*.pyc
*.tsbuildinfo
# Handgemachte, nicht reproduzierbare Daten werden bewusst versioniert:
# data/missions/*/ground_truth und data/missions/*/path_refinements.
# Alles Folgende ist entweder Duplikat oder aus diesen Daten neu berechenbar.

# Importordner: enthalten nur Duplikate der persistenten Missionsvideos.
# Bewusst als Muster, nicht einzeln aufgezaehlt — beim Anlegen von
# "Mission 3" wurden sonst 2,0 GB Video mitgestaged, weil der neue Ordner
# in keiner Liste stand.
data/Mission*/
data/mission*/
# ... aber NICHT der eigentliche Missionsordner: "data/mission*/" trifft auch
# "data/missions/" und wuerde damit die gesamte Handarbeit stillschweigend
# aussperren. Die 275 vorhandenen Ground-Truth-Dateien lagen nur deshalb im
# Repo, weil bereits getrackte Dateien von .gitignore unberuehrt bleiben; jedes
# NEUE Label waere verschwunden. Befund vom 04.08.2026.
!data/missions/

# Analyse-Artefakte: werden bei jedem Lauf vollstaendig neu geschrieben
# (aktuell 1.498 Dateien, 470 MB, darunter 333 MB JSON und 960 Evidenz-JPGs).
# Versioniert wuerde jeder Lauf eine komplette Kopie in der Historie ablegen.
data/**/derived/
data/runtime_cache/
data/global_models/*/video_analyses/

# Originalvideos: 6 Dateien, 3,1 GB. Bleiben bewusst dauerhaft lokal und
# werden nicht hochgeladen, auch nicht ueber LFS. Das Repo dient nur der
# Dokumentation und Versionierung des Codes.
data/missions/*/videos/

# Ausgabe des lokalen Dev-Servers (npm run dev), waechst unbegrenzt.
logs/

# Run-Registry: SQLite-Datei, Binaerformat. Struktur ist aus dem Videoordner
# rekonstruierbar, Status und Notiz sind es nicht — gehoert in eine Sicherung.
data/registry.sqlite

# Terrain-Vorhersagelaeufe: pro Video eine Zeile je Frame, aus Modell und Video
# jederzeit neu berechenbar. Der Trainingslauf bleibt versioniert, weil
# current.json auf ihn zeigt.
data/global_models/terrain_model/predictions/
